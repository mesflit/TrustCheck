    <string name="onboarding_next">Next</string>
    <string name="onboarding_optional">All permissions are optional. You can change them later in Settings.</string>
    <string name="onboarding_perm_body">To warn you automatically, TrustCheck needs permission to read notification text. Text is processed in memory to find links and is never stored or uploaded.</string>
    <string name="onboarding_perm_notif_access">Notification access</string>
