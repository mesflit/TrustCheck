    <string name="onboarding_finish">Start using TrustCheck</string>
    <string name="onboarding_granted">Granted</string>
    <string name="onboarding_how_body">TrustCheck analyzes links you share, paste or open with it, and — if you allow it — links that appear in your notifications. Checks run on your device first and work offline.</string>
