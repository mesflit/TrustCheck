<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat base is required for per-app language switching on Android 12 and lower.
         All UI is Jetpack Compose + Material 3; this theme only styles the window. -->
    <style name="Theme.TrustCheck" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorAccent">@color/brand_purple</item>
    </style>
</resources>
